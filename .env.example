# Google Gemini API configuration (server-side only — never exposed to the browser)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Optional local server settings
# PORT=3001
# HOST=127.0.0.1
# CHAT_TIMEOUT_MS=30000

# On Vercel: set GEMINI_API_KEY and GEMINI_MODEL in
# Project Settings → Environment Variables. Do not commit real keys.
