# ---------------------------------------------------------------------------
# Backend (Render web service) — SERVER-SIDE ONLY. Set these in the Render
# dashboard (Environment tab). Never prefix secrets with VITE_ and never
# commit real values; .env is gitignored.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed by CORS.
# Replace with your real Vercel domains. Wildcards are supported for
# preview deployments (e.g. https://thermos-ai-*.vercel.app).
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app

# Optional backend tuning (Render sets PORT automatically — do not override).
# PORT=3001
# HOST=0.0.0.0
# CHAT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Frontend (Vercel project settings → Environment Variables) — PUBLIC, build
# time only. Points the built app at the Render backend.
# Leave unset for local development so Vite proxies /api to the local server.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=https://your-render-service.onrender.com
